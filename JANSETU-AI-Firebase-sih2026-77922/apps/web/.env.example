# Copy to .env.local and replace placeholders with your own Firebase web-app config.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
# Optional Firebase Analytics measurement ID.
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional service endpoints. Configure only trusted services you control.
# VITE_AI_API_URL=https://your-service.example.com/api/assistant
# VITE_TRANSLATION_API_URL=https://your-service.example.com/api/translate
